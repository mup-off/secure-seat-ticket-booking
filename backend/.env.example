# Copy to backend/.env for local development. Never commit .env.
# Use different values in dev, test and production (plan, Phase 5).

DJANGO_ENV=development          # development | production
DEBUG=0                         # keep 0 unless you need Django's debug pages locally

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Use a dedicated role, not the "postgres" superuser.
DB_NAME=secureseat
DB_USER=secureseat
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# "mock" works only outside production. A real MTN MoMo / Airtel adapter is still to be
# built; its keys will go here (e.g. MOMO_SUBSCRIPTION_KEY, MOMO_API_USER, MOMO_API_KEY).
PAYMENT_PROVIDER=mock

# Set to 1 behind a reverse proxy that terminates HTTPS and sets X-Forwarded-Proto.
BEHIND_PROXY=0

# Optional tuning (defaults shown)
HOLD_MINUTES=10
MAX_TICKETS_PER_ORDER=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
